# Saimon Platform — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env (it's already in .gitignore).

# ---------------------------------------------------------------------------
# Required: per-service API keys
# Each MCP enforces its own API key. Use a DISTINCT strong random key per
# service in production (the container still reads SAIMON_API_KEY internally;
# the compose files map these per-service vars into it).
# ---------------------------------------------------------------------------
SAIMON_SEARCH_API_KEY=sk-your-search-key
SAIMON_GENERATE_API_KEY=sk-your-generate-key
SAIMON_EXPORT_API_KEY=sk-your-export-key
SAIMON_EVALUATE_API_KEY=sk-your-evaluate-key
SAIMON_VERIFY_API_KEY=sk-your-verify-key
SAIMON_EXPLORE_API_KEY=sk-your-explore-key

# ---------------------------------------------------------------------------
# domain-mcp — domain plugin loader + tool router
# SAIMON_DOMAIN_API_KEY: distinct strong random key for the domain MCP
# SAIMON_DOMAIN_PLUGIN_PATHS: comma-separated dotted Python module paths
# ---------------------------------------------------------------------------
SAIMON_DOMAIN_API_KEY=sk-your-domain-key
SAIMON_DOMAIN_PLUGIN_PATHS=plugins.legal

# ---------------------------------------------------------------------------
# Required: PostgreSQL connection string
# All MCPs access the shared knowledge graph.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://saimon:your-password@localhost:5432/saimon

# ---------------------------------------------------------------------------
# Required for api-mcp: JWT signing secret
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
SAIMON_JWT_SECRET=generate-a-random-secret-here

# ---------------------------------------------------------------------------
# Required for generate-mcp, evaluate-mcp, verify-mcp
# DeepSeek API key for LLM-powered features.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------------------------------------------------------------------------
# Optional: DeepSeek base URL (defaults to official API)
# ---------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------------------------------------------------------------------------
# Optional: PostgreSQL superuser password (docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=your-secure-password

# ---------------------------------------------------------------------------
# Environment mode
# Set to "production" to enforce strict secret validation
# (rejects default "sk-test-*" keys).
# ---------------------------------------------------------------------------
SAIMON_ENV=development

# ---------------------------------------------------------------------------
# Per-service database passwords (docker-compose defaults shown)
# Each MCP connects with its own role; leave these unset in development and
# set distinct values in any shared or production environment.
# ---------------------------------------------------------------------------
SEARCH_DB_PASSWORD=saimon-search-dev
GENERATE_DB_PASSWORD=saimon-generate-dev
EXPORT_DB_PASSWORD=saimon-export-dev
EVALUATE_DB_PASSWORD=saimon-evaluate-dev
VERIFY_DB_PASSWORD=saimon-verify-dev
EXPLORE_DB_PASSWORD=saimon-explore-dev
DOMAIN_DB_PASSWORD=saimon-domain-dev
API_DB_PASSWORD=saimon-api-dev
CREW_DB_PASSWORD=saimon-crew-dev

# ---------------------------------------------------------------------------
# Inter-service URLs (docker-compose defaults shown). Override when running a
# service outside the compose network.
# ---------------------------------------------------------------------------
SEARCH_MCP_URL=http://search-mcp:8001
EVALUATE_MCP_URL=http://evaluate-mcp:8004
VERIFY_MCP_URL=http://verify-mcp:8005
EXPLORE_MCP_URL=http://explore-mcp:8006

# ---------------------------------------------------------------------------
# Additional service keys (compose defaults shown; replace in production)
# ---------------------------------------------------------------------------
SAIMON_CREW_API_KEY=sk-test-crew-key

# ---------------------------------------------------------------------------
# Optional: web search provider for the `search_web` tool. Absent this, the
# tool returns an empty result set with a stated reason rather than failing.
# ---------------------------------------------------------------------------
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: AI-text detection tuning
# ---------------------------------------------------------------------------
SAIMON_AI_DETECT_THRESHOLD=0.5
SAIMON_AI_DETECT_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Optional: path to a planning checkout, used only by the crew service's
# research jobs. Leave unset unless you use that feature.
# ---------------------------------------------------------------------------
# PLANNING_CHECKOUT_PATH=/path/to/planning
