# Saimon Platform — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env (it's already in .gitignore).

# ---------------------------------------------------------------------------
# Required: Saimon internal API key
# All MCPs require this. Generate a strong random key for production.
# ---------------------------------------------------------------------------
SAIMON_API_KEY=sk-your-real-key-here

# ---------------------------------------------------------------------------
# Required: PostgreSQL connection string
# All MCPs access the shared knowledge graph.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://saimon:your-password@localhost:5432/saimon

# ---------------------------------------------------------------------------
# Required for api-mcp: JWT signing secret
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
SAIMON_JWT_SECRET=generate-a-random-secret-here

# ---------------------------------------------------------------------------
# Required for generate-mcp, evaluate-mcp, verify-mcp
# DeepSeek API key for LLM-powered features.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------------------------------------------------------------------------
# Optional: DeepSeek base URL (defaults to official API)
# ---------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------------------------------------------------------------------------
# Optional: PostgreSQL superuser password (docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=your-secure-password

# ---------------------------------------------------------------------------
# Environment mode
# Set to "production" to enforce strict secret validation
# (rejects default "sk-test-*" keys).
# ---------------------------------------------------------------------------
SAIMON_ENV=development
