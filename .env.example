# Saimon Platform — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env (it's already in .gitignore).

# ---------------------------------------------------------------------------
# Required: per-service API keys
# Each MCP enforces its own API key. Use a DISTINCT strong random key per
# service in production (the container still reads SAIMON_API_KEY internally;
# the compose files map these per-service vars into it).
# ---------------------------------------------------------------------------
SAIMON_SEARCH_API_KEY=sk-your-search-key
SAIMON_GENERATE_API_KEY=sk-your-generate-key
SAIMON_EXPORT_API_KEY=sk-your-export-key
SAIMON_EVALUATE_API_KEY=sk-your-evaluate-key
SAIMON_VERIFY_API_KEY=sk-your-verify-key
SAIMON_EXPLORE_API_KEY=sk-your-explore-key

# ---------------------------------------------------------------------------
# Required: PostgreSQL connection string
# All MCPs access the shared knowledge graph.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://saimon:your-password@localhost:5432/saimon

# ---------------------------------------------------------------------------
# Required for api-mcp: JWT signing secret
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
SAIMON_JWT_SECRET=generate-a-random-secret-here

# ---------------------------------------------------------------------------
# Required for generate-mcp, evaluate-mcp, verify-mcp
# DeepSeek API key for LLM-powered features.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------------------------------------------------------------------------
# Optional: DeepSeek base URL (defaults to official API)
# ---------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------------------------------------------------------------------------
# Optional: PostgreSQL superuser password (docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=your-secure-password

# ---------------------------------------------------------------------------
# Environment mode
# Set to "production" to enforce strict secret validation
# (rejects default "sk-test-*" keys).
# ---------------------------------------------------------------------------
SAIMON_ENV=development
